# ==========================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ==========================================
# Get your free Neon PostgreSQL serverless database at: https://neon.tech
DATABASE_URL="postgresql://neondb_owner:password@ep-greenfield-meadows.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# AUTH0 AUTHENTICATION CONFIGURATION
# ==========================================
# Setup Auth0 Application at: https://manage.auth0.com/
AUTH0_SECRET="use-a-strong-random-32-byte-hex-string-for-session-encryption"
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_ISSUER_BASE_URL="https://dev-greenfield.us.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"

# ==========================================
# SATELLITE MAP PROVIDER (Optional MapTiler/Mapbox)
# ==========================================
NEXT_PUBLIC_MAP_PROVIDER="esri"
# NEXT_PUBLIC_MAPTILER_KEY="your-maptiler-key"
